# Copiar este archivo a ".env" y ajustar si es necesario.
# Estas variables las consumen docker-compose.yml y los scripts de Python.

POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachute
POSTGRES_DB=parachute_faqs
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Cadena de conexión usada por los scripts de Python (loader y, más adelante, el agente).
DATABASE_URL=postgresql://parachute:parachute@localhost:5432/parachute_faqs

# Modelo de embeddings de sentence-transformers (pequeño, corre localmente sin GPU).
EMBEDDING_MODEL=all-MiniLM-L6-v2
